# Copy this file to ".env" and fill in your values.

# Your PostgreSQL connection string.
#  - Neon:  copy it from the Neon dashboard -> "Connect" (it ends with ?sslmode=require)
#  - Local: postgresql://postgres:YOUR_PASSWORD@localhost:5432/flixbooking
DATABASE_URL=postgresql://neondb_owner:npg_imHz65acThVX@ep-withered-block-a1b50tz6.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Any long random string. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# Where the React app runs (comma-separated if more than one)
CORS_ORIGINS=http://localhost:5173

# Booking rules
SEAT_HOLD_MINUTES=10
MAX_SEATS_PER_BOOKING=10
CONVENIENCE_FEE_PER_SEAT=25
